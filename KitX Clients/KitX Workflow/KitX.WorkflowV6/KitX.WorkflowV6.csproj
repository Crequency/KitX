<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>KitX.WorkflowV6</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <Version>24.10.$([System.DateTime]::UtcNow.Date.Subtract($([System.DateTime]::Parse("2024-02-07"))).TotalDays).$([System.Math]::Floor($([System.DateTime]::UtcNow.TimeOfDay.TotalMinutes)))</Version>
  </PropertyGroup>

  <!-- Allow the V6 test project to access internal members. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>KitX.WorkflowV6.Test.Xunit</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Match KitX.WorkflowIR: DI abstractions come via the shared framework. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\KitX Standard\KitX Core Contracts\KitX.Core.Contract\KitX.Core.Contract.csproj" />
    <ProjectReference Include="..\..\..\KitX Standard\KitX Shared\KitX.Shared.CSharp\KitX.Shared.CSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Roslyn is used by the future structured-C# execution backend (Phase: Runtime Compilation).
      Pinned to match KitX.WorkflowIR so both libraries can coexist in the Dashboard bin directory
      without assembly-version binding redirects.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.3.0" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <!--
      Superpower is retained tentatively: the v6 indented parser may or may not be built on it
      (see discussion notes §10.8 "BS 解析器的选型"). Pulling it now keeps the experimental space
      unconstrained; if a custom indented parser is chosen later, the dependency can be dropped.
    -->
    <PackageReference Include="Superpower" Version="3.2.1" />
  </ItemGroup>

</Project>
