<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="11.3.13" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.13" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!--
    The test references the renderer, the layout library it is judged against, and the writer's
    serializer options — and nothing else.

    In particular it does NOT reference KitX.ToolKit: the criterion compares two implementations that
    must not be able to consult each other, and a test project with a path to the scheduler would be
    the first place that boundary got crossed for convenience.

    KitX.ToolKit.View.Server is here for one reason: ViewWire.Options is the writer's real instance,
    and the reader test deserialising with it is what makes a drifting byte-constant fail instead of
    passing on a reader more permissive than the writer. That project references only the contract,
    so this adds the options and not the server.
  -->
  <ItemGroup>
    <ProjectReference Include="..\KitX.ToolKit.View.Avalonia\KitX.ToolKit.View.Avalonia.csproj" />
    <ProjectReference Include="..\KitX.ToolKit.View\KitX.ToolKit.View.csproj" />
    <ProjectReference Include="..\KitX.ToolKit.View.Server\KitX.ToolKit.View.Server.csproj" />
    <!--
      The host window, so RemoteWindowTests can open one and assert what it drew. An executable is
      fine to reference from a test project; what this does NOT buy is a route to the implementation
      assembly, because the host's own metadata is asserted free of KitX.ToolKit by
      ProductBoundaryTests. A test that references the host still cannot name DataStore.
    -->
    <ProjectReference Include="..\KitX.ToolKit.View.Avalonia.Host\KitX.ToolKit.View.Avalonia.Host.csproj" />
  </ItemGroup>

</Project>
