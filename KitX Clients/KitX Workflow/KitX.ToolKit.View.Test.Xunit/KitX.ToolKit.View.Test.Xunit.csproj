<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!--
    ADR-0014 D5 makes "only the Contract" a rule for the shipped library, not for its tests. The
    test project still references just the View library: if a test ever needed the implementation,
    that would be the signal that the library's surface is too thin to be useful.
  -->
  <ItemGroup>
    <ProjectReference Include="..\KitX.ToolKit.View\KitX.ToolKit.View.csproj" />
  </ItemGroup>

</Project>
