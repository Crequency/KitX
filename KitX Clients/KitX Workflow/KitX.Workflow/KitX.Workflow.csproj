<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>KitX.Workflow</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <Version>24.10.$([System.DateTime]::UtcNow.Date.Subtract($([System.DateTime]::Parse("2024-02-07"))).TotalDays).$([System.Math]::Floor($([System.DateTime]::UtcNow.TimeOfDay.TotalMinutes)))</Version>
  </PropertyGroup>

  <!-- Allow test/tools projects to access internal members (CSCompiler, BlockScriptExecutor internals, ...) -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>KitX.Core.DI.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>KitX.Workflow.Test.Xunit</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>KitX.Workflow.Tools</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Match KitX.Core: Microsoft.Extensions.DependencyInjection comes via the shared framework -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\KitX Standard\KitX Core Contracts\KitX.Core.Contract\KitX.Core.Contract.csproj" />
    <ProjectReference Include="..\..\..\KitX Standard\KitX Shared\KitX.Shared.CSharp\KitX.Shared.CSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Csharpell.Core provides CSharpScriptEngine used by WorkflowRuntimeState -->
    <PackageReference Include="Csharpell.Core" Version="1.0.0" Condition="!Exists('..\..\..\Reference\CSharpell\Csharpell.Core\Csharpell.Core.csproj')" />
    <ProjectReference Include="..\..\..\Reference\CSharpell\Csharpell.Core\Csharpell.Core.csproj" Condition="Exists('..\..\..\Reference\CSharpell\Csharpell.Core\Csharpell.Core.csproj')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.3.0" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <!-- Superpower: token-driven parser combinator for the BS (BlockScript) parse layer.
         Apache-2.0 (Datalust). License text in KitX Dashboard Assets/ThirdPartyLicense.md.
         Roslyn remains for C# code emission + assembly compilation; Superpower only owns BS parsing. -->
    <PackageReference Include="Superpower" Version="3.2.1" />
  </ItemGroup>

</Project>
