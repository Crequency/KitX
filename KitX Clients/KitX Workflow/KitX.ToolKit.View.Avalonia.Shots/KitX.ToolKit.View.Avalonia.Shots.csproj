<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The renderer's own output path.

    Why this project exists rather than a demo: for a while the only way to see what SurfaceCard
    actually draws was a program outside version control. A picture produced by an untracked program
    is not evidence — it is reproducible only on the machine that has it. This project is tracked,
    its scenarios are data files, and one command regenerates every image.

    It deliberately references only the renderer and the layout library, for the same reason
    KitX.ToolKit.View.Avalonia.Test.Xunit does (see that csproj): reaching the scheduler from here
    would let a "screenshot" consult a second source of truth.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <RootNamespace>KitX.ToolKit.View.Avalonia.Shots</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.13" />
    <PackageReference Include="Avalonia.Headless" Version="11.3.13" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.13" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KitX.ToolKit.View.Avalonia\KitX.ToolKit.View.Avalonia.csproj" />
    <ProjectReference Include="..\KitX.ToolKit.View\KitX.ToolKit.View.csproj" />
  </ItemGroup>

  <!-- The scenarios ship with the tool, so `dotnet run` with no arguments renders every one. -->
  <ItemGroup>
    <None Include="scenarios\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
