<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KitX.ToolKit\KitX.ToolKit.csproj" />
    <ProjectReference Include="..\KitX.ToolKit.Hosting\KitX.ToolKit.Hosting.csproj" />
    <ProjectReference Include="..\KitX.ToolKit.Contract\KitX.ToolKit.Contract.csproj" />
    <!--
      The protocol client, so a test can fold what the server actually put on the wire into the
      projection a real View would build. ADR-0014 D5 forbids the VIEW LIBRARY from referencing
      ToolKit; it says nothing about a test project seeing both, and without one the two halves
      are only ever checked against themselves — which is how `appended` came to mean two different
      things on each side with every test green.
    -->
    <ProjectReference Include="..\KitX.ToolKit.View\KitX.ToolKit.View.csproj" />
    <ProjectReference Include="..\KitX.WorkflowV6\KitX.WorkflowV6.csproj" />
  </ItemGroup>

</Project>
